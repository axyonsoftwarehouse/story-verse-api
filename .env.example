# Porta do servidor HTTP.
PORT=8080

# Banco Postgres (stack storyverse). Em produção o compose aponta para db:5432.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/storyverse
# Runtime sem ownership/superuser/bypassrls; migrations usam SPRING_FLYWAY_*.
SPRING_DATASOURCE_USERNAME=storyverse_api
SPRING_DATASOURCE_PASSWORD=
# true: o boot falha se o runtime puder ignorar RLS (owner, superuser ou bypassrls).
APP_REQUIRE_RUNTIME_ROLE=true

# Origem(ns) permitidas no CORS, separadas por virgula.
APP_CORS_ALLOWED_ORIGINS=https://storyverse.2.29.42.104.sslip.io

# Rate limit persistente no Postgres (compartilhado entre instâncias). Fallback local se o banco falhar.
APP_RATE_LIMIT_PERSISTENT=true
# Pool do Hikari (o rate limit usa uma conexão REQUIRES_NEW).
# DB_POOL_SIZE=20

# Endereco publico usado nos links de confirmacao e recuperacao de senha.
APP_PUBLIC_URL=https://storyverse.2.29.42.104.sslip.io
# Host publico da API (aceito em capas do acervo).
APP_PUBLIC_API_URL=https://api.storyverse.2.29.42.104.sslip.io
# Hosts HTTPS permitidos em cover_url, alem dos caminhos locais do Storage.
# APP_COMMUNITY_COVER_HOSTS=covers.openlibrary.org,openlibrary.org,www.openlibrary.org,archive.org,www.archive.org
APP_AUTH_REQUIRE_EMAIL_CONFIRMATION=true
# APP_AUTH_CONFIRMATION_TTL=PT24H
# APP_AUTH_RESET_TTL=PT1H
# Cookie do refresh token. Em produção: Secure=true e SameSite=Lax.
# Para desenvolvedor cross-site (localhost -> API remota), use SameSite=None (exige HTTPS).
APP_AUTH_REFRESH_COOKIE_SECURE=true
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Lax

# Pasta dos arquivos (fotos de perfil, livros importados, acervo da comunidade).
STORAGE_DIR=/data/media

# SMTP dos e-mails de confirmacao e recuperacao. Sem estas variaveis, cadastro
# e recuperacao de senha respondem 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@seudominio.com
SMTP_FROM_NAME=Storyverse
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# IA (chaves no SERVIDOR; nunca expostas ao navegador). Sem nenhuma, o chat fica em modo demonstracao.
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free

# Cota de IA no servidor (cada mensagem gera uma reserva no banco).
# AI_DAILY_MESSAGE_LIMIT=50
# AI_DAILY_GLOBAL_LIMIT=0
# AI_PER_MINUTE_LIMIT=6

# Assinatura (Stripe). Chaves só no servidor; nunca use VITE_* no frontend.
# Deixe BILLING_ENABLED=false no beta: o gate só liga quando a flag estiver true.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# BILLING_PRICE_LABEL=R$ 9,90
# BILLING_TRIAL_DAYS=7
# BILLING_PAST_DUE_GRACE_DAYS=3

# Sentry (opcional; sem DSN o SDK fica desligado).
# SENTRY_DSN=https://...@...ingest.us.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=<sha>
# SENTRY_TRACES_SAMPLE_RATE=0
