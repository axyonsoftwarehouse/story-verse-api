# Porta do servidor HTTP.
PORT=8080

# Banco Postgres (stack storyverse). Em produção o compose aponta para db:5432.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/storyverse
SPRING_DATASOURCE_USERNAME=storyverse
SPRING_DATASOURCE_PASSWORD=

# Origem(ns) permitidas no CORS, separadas por virgula.
APP_CORS_ALLOWED_ORIGINS=https://storyverse.2.29.42.104.sslip.io

# Endereco publico usado nos links de confirmacao e recuperacao de senha.
APP_PUBLIC_URL=https://storyverse.2.29.42.104.sslip.io
APP_AUTH_REQUIRE_EMAIL_CONFIRMATION=true
# APP_AUTH_CONFIRMATION_TTL=PT24H
# APP_AUTH_RESET_TTL=PT1H

# Pasta dos arquivos (fotos de perfil, livros importados, acervo da comunidade).
STORAGE_DIR=/data/media

# SMTP dos e-mails de confirmacao e recuperacao. Sem estas variaveis, cadastro
# e recuperacao de senha respondem 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@seudominio.com
SMTP_FROM_NAME=Storyverse
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# IA (chaves no SERVIDOR; nunca expostas ao navegador). Sem nenhuma, o chat fica em modo demonstracao.
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free

# Cota de IA no servidor (cada mensagem gera uma reserva no banco).
# AI_DAILY_MESSAGE_LIMIT=50
# AI_DAILY_GLOBAL_LIMIT=0
# AI_PER_MINUTE_LIMIT=6

# Sentry (opcional; sem DSN o SDK fica desligado).
# SENTRY_DSN=https://...@...ingest.us.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=<sha>
# SENTRY_TRACES_SAMPLE_RATE=0
